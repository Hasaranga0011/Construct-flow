{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "ANDROID_ARM64_ONLY": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "22.22.0"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "node": "22.22.0"
    }
  }
}
