\n};\r\n\r\nexport const buildNotificationFilter = (userId: string, role?: string | null) => {\r\n  const roleFilters = getNotificationRoleAliases(role).map((value) => `target_role.eq.${value}`);\r\n  return `target_user_id.eq.${userId},and(target_user_id.is.null,or(${['target_role.eq.All', ...roleFilters].join(',')}))`;\r\n};\r\n\r\nexport const isNotificationForUser = (\r\n  notification: { target_role?: string | null; target_user_id?: string | null },\r\n  userId: string,\r\n  role?: string | null,\r\n) => notification.target_user_id === userId\r\n  || (notification.target_user_id == null\r\n    && (notification.target_role === 'All'\r\n      || getNotificationRoleAliases(role).includes(notification.target_role || '')));","removeUnusedVar",{"varName":"1740"},{"range":"1741","text":"1556"},"Remove unused variable \"TextInput\".",{"varName":"1740"},{"range":"1742","text":"1556"},"removeUnusedImportDeclaration",{"varName":"1743"},{"range":"1744","text":"1556"},"Remove unused import declaration.",{"varName":"1745"},{"range":"1746","text":"1556"},{"varName":"1747"},{"range":"1748","text":"1556"},"Remove unused variable \"Alert\".","Update the dependencies array to be: [fetchExpenses, projectId]",{"range":"1749","text":"1750"},{"varName":"1747"},{"range":"1751","text":"1556"},{"varName":"1747"},{"range":"1752","text":"1556"},"Update the dependencies array to be: [fetchMilestones, projectId]",{"range":"1753","text":"1754"},{"varName":"1747"},{"range":"1755","text":"1556"},{"varName":"1756"},{"range":"1757","text":"1556"},{"varName":"1747"},{"range":"1758","text":"1556"},{"varName":"1759"},{"range":"1760","text":"1556"},"Remove unused variable \"Platform\".",{"varName":"1761"},{"range":"1762","text":"1556"},"Remove unused variable \"MaterialIcons\".",{"varName":"1763"},{"range":"1764","text":"1556"},"Remove unused variable \"Image\".",{"varName":"1765"},{"range":"1766","text":"1556"},"Remove unused variable \"Linking\".",{"varName":"1761"},{"range":"1767","text":"1556"},