    "tunnel": "node --max-old-space-size=4096 --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --tunnel -c",
    "android": "node --max-old-space-size=4096 --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --android",
    "ios": "node --max-old-space-size=4096 --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --ios",
    "web": "node --max-old-space-size=4096 --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --web",
    "build": "npx expo export -p web",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:local-check": "npx expo-doctor && npx expo install --check && npx tsc --noEmit",
