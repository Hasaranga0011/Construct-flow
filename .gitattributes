# Auto detect text files and perform LF normalization
* text=auto

# ---------------------------------------------------------------
# ML model artifacts — MUST be treated as binary.
# These are committed via Git LFS.  Never let Git normalize
# line-endings on binary pickle/joblib files; doing so silently
# corrupts the file and causes KeyError on joblib.load().
# ---------------------------------------------------------------
*.pkl         filter=lfs diff=lfs merge=lfs -text
*.joblib      filter=lfs diff=lfs merge=lfs -text
*.pkl.gz      filter=lfs diff=lfs merge=lfs -text
*.joblib.gz   filter=lfs diff=lfs merge=lfs -text
*.npy         filter=lfs diff=lfs merge=lfs -text
*.npz         filter=lfs diff=lfs merge=lfs -text
