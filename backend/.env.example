SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-public-anon-key
# Server only. Never use this key in EXPO_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
ENVIRONMENT=development
FRONTEND_URL=http://localhost:8082
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
# Browser-restricted key. Enable Maps JavaScript API + Places API (New), with billing.
# Also enable Geocoding API to resolve addresses when manually pinning the map.
# Allow the API frame origins (e.g. http://localhost:8000/* and http://127.0.0.1:8000/*).
# This key is intended for browser delivery; never use a private/server-restricted key here.
GOOGLE_MAPS_BROWSER_KEY=
# Optional Google Cloud map ID. Without it, local testing uses Google's demo map ID.
GOOGLE_MAP_ID=
# Server-only Geoapify key. When configured, Geoapify search + the free map take priority.
GEOAPIFY_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=ConstructFlow <noreply@your-verified-domain.example>
ENABLE_SMTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Run scheduled tasks in exactly one designated backend process.
ENABLE_SCHEDULER=false
# Development only; production uploads must use configured object storage.
ALLOW_LOCAL_UPLOADS=false
# Optional persistent directory for local history cache and trusted model artifacts.
# CONSTRUCTFLOW_MODEL_DIR=/var/lib/constructflow/models
